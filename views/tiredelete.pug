extends layout

block content
  h1= title

  if (toShow == null)
    h2 No instance to delete
  else
    - let tireid = toShow._id
    - let tire_type = toShow.tire_type
    - let tirecost = toShow.cost
    - let tiresize = toShow.size
    - let actionid = "/resource/tires/" + tireid
    script let actionid = "#{actionid}"
    div
      div.row
        div(class='tireAttr mr-3') Tire ID is:
        div #{tireid}
      div.row
        div(class='tireAttr mr-3') Tire Type is:
        div #{tire_type}
      div.row
        div(class='tireAttr mr-3') Tire Size is:
        div #{tiresize}
      div.row
        div(class='tireAttr mr-3') Tire Cost is:
        div #{tirecost}

    button(class="btn btn-danger m-2" onclick="deleteOnid()") Delete
    button(class="btn btn-secondary m-2" onclick="cancel()") Cancel

  script.
    function cancel() {
      // Go back to the home page for the tires collection
      window.location.href='/tires'
    }
  script.
    function deleteOnid() {
      console.log("starting delete")
      // delete first
      fetch(actionid, {
        method: 'DELETE'      // Don't need a body for the delete
      }).then((resp) => {
        return resp.json(); // or resp.text() or whatever the server sends
      }).then((body) => {
        alert("Delete succeded")
        window.location.href='/tires'
        // TODO handle body
      }).catch((error) => {
        // TODO handle error
        alert("Delete failed " + error )
      });
    }