extends layout

block content
  h1= title
  div(class="container-fluid")
    div(class="row")
      each item in results
        div(class="col-sm-2")
          p(class="small") Type: #{item.tire_type}
          p(class="small") Size: #{item.size}
          p(class="small") Cost: $#{item.cost}
  
  br
  a(href="/") Back to Home Page