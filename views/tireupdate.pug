extends layout

block content
  h1= title

  if (toShow == null)
    h2 No instance to update
  else
    - let tireid = toShow._id
    - let tire_type = toShow.tire_type
    - let tirecost = toShow.cost
    - let tiresize = toShow.size
    
    div.row(class='mb-2')
      div.mr-1 ID is
      div #{tireid}
    
    - let actionid = "/resource/tires/" + tireid
    form(id='TireForm', action= actionid, method="PUT")
      div.form-group
        label.tireAttr(for='tire_type') Tire type
        input#tire_type(type='text', name='tire_type', value= tire_type )
      div.form-group
        label.tireAttr(for='size') Tire size
        input#size(type='text', name='size', value= tiresize )
      div.form-group
        label.tireAttr(for='cost') Tire cost
        input#cost(type='number', name='cost', value= tirecost )
      input(type="submit")

    script.
      document.forms['TireForm'].addEventListener('submit', (event) => {
        event.preventDefault();
        // TODO do something here to show user that form is being submitted
        fetch(event.target.action, {
          method: 'PUT',
          body: new URLSearchParams(new FormData(event.target)) // event.target is the form
        }).then((resp) => {
          return resp.json(); // or resp.text() or whatever the server sends
        }).then((body) => {
          alert("Update succeded")
          // TODO handle body
        }).catch((error) => {
          // TODO handle error
          alert("Update failed " + error )
        });
      });